# Sibling repository locations (absolute paths are also accepted)
FRONTEND_SERVICE_DIR=../frontend-service
AUTH_SERVICE_DIR=../auth-service
NETWORK_SERVICE_DIR=../network-service
AWS_SERVICE_DIR=../aws-service

# Existing local MySQL 8 server and bootstrap administrator
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Isolated service databases and users
AUTH_MYSQL_DATABASE=mis_auth
AUTH_MYSQL_USER=mis_auth
AUTH_MYSQL_PASSWORD=auth-dev-password
NETWORK_MYSQL_DATABASE=mis_network
NETWORK_MYSQL_USER=mis_network
NETWORK_MYSQL_PASSWORD=network-dev-password
AWS_MYSQL_DATABASE=mis_aws
AWS_MYSQL_USER=mis_aws
AWS_MYSQL_PASSWORD=aws-dev-password

# Local HTTP endpoints
FRONTEND_ORIGIN=http://localhost:5173
AUTH_PORT=8000
NETWORK_PORT=8001
AWS_PORT=8002
